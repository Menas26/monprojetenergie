# Variables PUBLIQUES (visibles dans le navigateur, sans danger). Définies dans Cloudflare Pages > Variables (build).
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=clé-anon-publique
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Laisser vide tant que le suivi n'est pas prêt. Exemple : GTM-XXXXXXX
PUBLIC_GTM_ID=

# Mode aperçu (valeurs par défaut si absentes) :
# PUBLIC_NOINDEX : "false" seulement le jour du lancement officiel (sinon Google n'indexe pas le site).
# PUBLIC_FORM_ENABLED : "true" seulement quand Supabase, Resend et Turnstile sont configurés.
PUBLIC_NOINDEX=true
PUBLIC_FORM_ENABLED=false
